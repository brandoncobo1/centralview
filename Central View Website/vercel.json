{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/rooms/city-view", "destination": "/rooms/city-view.html" },
    { "source": "/rooms/adriatic-suite", "destination": "/rooms/adriatic-suite.html" },
    { "source": "/rooms/penthouse-360", "destination": "/rooms/penthouse-360.html" },
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/reviews", "destination": "/reviews.html" },
    { "source": "/location", "destination": "/location.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/story", "destination": "/story.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" }
  ]
}
